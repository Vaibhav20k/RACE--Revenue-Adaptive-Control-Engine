# Environment Configuration for RACE (Revenue Adaptive Control Engine)
# Track 03: AI Revenue Recovery

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://race_user:race_password@localhost:5432/race_db
REDIS_URL=redis://localhost:6379/0

# Razorpay Test Mode Credentials (NEVER USE LIVE KEYS)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# AI Agent / LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=mock_or_actual_openai_key

# Economic & Safety Parameters
MAX_AUTOMATED_AMOUNT_INR=50000.0
MAX_RETRY_COUNT=3
MIN_COOLDOWN_MINUTES=30
RECOVERY_WINDOW_HOURS=72
DEFAULT_ACTION_COST_INR=5.0
DEFAULT_FRICTION_PENALTY_INR=10.0
DEFAULT_RISK_PENALTY_INR=5.0
